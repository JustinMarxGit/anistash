[Unit]
Description=anidl web UI for ani-cli
Documentation=https://github.com/JustinMarxGit/anidl
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=anidl
Group=anidl
EnvironmentFile=/etc/anidl/anidl.env
WorkingDirectory=/opt/anidl
ExecStart=/opt/anidl/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${ANIDL_PORT} --proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
# ffmpeg remuxes and ani-cli runs as child processes; stop them with the service
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
