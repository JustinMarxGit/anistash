[Unit]
Description=anistash web UI for ani-cli
Documentation=https://github.com/JustinMarxGit/anistash
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=anistash
Group=anistash
EnvironmentFile=/etc/anistash/anistash.env
WorkingDirectory=/opt/anistash
ExecStart=/opt/anistash/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${ANISTASH_PORT} --proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
# ffmpeg remuxes and ani-cli runs as child processes; stop them with the service
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
