#!/usr/bin/env bash
# Updates anistash inside its LXC to the newest GitHub release.
#
#   anistash-update              update to the newest release (asks first)
#   anistash-update -y           same, without asking
#   anistash-update --check      only report whether an update exists
#   anistash-update --version v0.2.0   install a specific release (also for downgrades)
#   anistash-update --branch main      follow a branch instead of releases (bleeding edge)
#
# Your settings, locations, queue and downloads are kept. If the new version fails
# to install, the previous one is put back.
set -euo pipefail

APP=/opt/anistash
if [[ -f /etc/anistash/anistash.env ]]; then
    set -a
    # shellcheck disable=SC1091
    . /etc/anistash/anistash.env
    set +a
fi
REPO="${ANISTASH_REPO:-JustinMarxGit/anistash}"
PORT="${ANISTASH_PORT:-8000}"

GN=$'\e[32m' YW=$'\e[33m' RD=$'\e[31m' BL=$'\e[36m' CL=$'\e[0m'
ok() { echo -e " ${GN}✓${CL} $*"; }
info() { echo -e " ${BL}…${CL} $*"; }
warn() { echo -e " ${YW}!${CL} $*"; }
die() { echo -e " ${RD}✗${CL} $*" >&2; exit 1; }

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

check_only=0 assume_yes=0 target="" branch=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) check_only=1 ;;
        -y | --yes) assume_yes=1 ;;
        --version) target="${2:?--version needs a tag like v0.2.0}"; shift ;;
        --branch) branch="${2:?--branch needs a name}"; shift ;;
        -h | --help) usage ;;
        *) echo "Unknown option: $1"; usage 1 ;;
    esac
    shift
done

[[ $EUID -eq 0 ]] || die "Run anistash-update as root (it reinstalls system files)."
[[ -d $APP/.git ]] || die "$APP is not a git checkout. Was anistash installed with install.sh?"

current="v$(cat "$APP/VERSION")"
current_ref="$(git -C "$APP" describe --tags --always 2>/dev/null || echo unknown)"

latest_release() {
    curl -fsSL -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$REPO/releases/latest" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])'
}

if [[ -n $branch ]]; then
    want="$branch"
    info "Following branch $branch of $REPO"
elif [[ -n $target ]]; then
    want="$target"
else
    want="$(latest_release)" || die "Couldn't read the latest release from GitHub ($REPO). Check the network, or use --branch main."
fi

if [[ -z $branch && $want == "$current" ]]; then
    ok "anistash $current is the newest release."
    exit 0
fi
if [[ $check_only -eq 1 ]]; then
    if [[ -n $branch ]]; then
        echo "Installed: $current_ref. Branch $branch would be pulled."
    else
        echo "Update available: $current → $want"
        echo "Run: anistash-update"
    fi
    exit 10
fi

echo "AniStash: $current ($current_ref) → $want"
if [[ $assume_yes -eq 0 && -t 0 ]]; then
    read -r -p "Update now? Downloads in progress will restart. [Y/n] " answer
    [[ ${answer:-y} =~ ^[Yy] ]] || exit 0
fi

previous="$(git -C "$APP" rev-parse HEAD)"
rollback() {
    warn "Update failed, going back to $current_ref"
    git -C "$APP" checkout --quiet --force "$previous"
    bash "$APP/install/deploy.sh" || true
    systemctl restart anistash.service || true
    die "anistash is back on $current_ref. Nothing else was changed."
}

info "Downloading $want"
git -C "$APP" fetch --quiet --tags --force origin
if [[ -n $branch ]]; then
    git -C "$APP" fetch --quiet origin "$branch"
    git -C "$APP" checkout --quiet --force -B "$branch" "origin/$branch"
else
    git -C "$APP" rev-parse --verify --quiet "refs/tags/$want" >/dev/null || die "Release $want doesn't exist."
    git -C "$APP" checkout --quiet --force "refs/tags/$want"
fi
ok "Fetched $(git -C "$APP" describe --tags --always)"

trap rollback ERR
info "Installing"
bash "$APP/install/deploy.sh"
systemctl restart anistash.service
for _ in $(seq 1 30); do
    curl -fs "http://127.0.0.1:$PORT/api/status" >/dev/null && break
    sleep 1
done
curl -fs "http://127.0.0.1:$PORT/api/status" >/dev/null || false  # not up after 30s: roll back
trap - ERR
ok "anistash is now on v$(cat "$APP/VERSION") ($(git -C "$APP" describe --tags --always))"

info "Updating ani-cli and yt-dlp"
"/usr/local/lib/anistash/anistash-helper" update-tools >/dev/null && ok "Tools updated" || warn "Tool update failed (anistash still works; try again later)"
